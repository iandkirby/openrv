# The Sequence Group — studio build configuration.
# Sourced by scripts/build_openrv.sh; environment variables set before the
# script runs take precedence over the defaults recorded here.
#
# This file IS the studio's codec/platform decision of record. Change it in a
# reviewed commit, not ad hoc on a build machine.

# Primary deployment platform (informational; the build runs on the host OS).
: "${SEQ_TARGET_PLATFORM:=windows}"

# VFX Reference Platform year for the OpenRV build (upstream's rvcmds.sh
# prompts interactively when unset — fatal in CI). CY2024 = Python 3.11,
# Qt 6.5.3, the stable pairing for OpenRV v3.2.x.
: "${RV_VFX_PLATFORM:=CY2024}"

# Apply studio branding (splash + icons from branding/) to the source tree
# before building. On by default now that the real Sequence logo is in the
# repo; set SEQ_APPLY_BRANDING=0 for a vanilla-look build.
: "${SEQ_APPLY_BRANDING:=1}"

# Non-free DECODERS to enable in the OpenRV build (comma-separated; converted
# to CMake list form by build_openrv.sh). Verified mechanism at v3.2.0:
#   * hevc — the decoder is compiled but gated by RV's runtime disallow list
#     (src/lib/image/mio_ffmpeg/init.cpp); listing it here lifts the gate.
#   * aac family — disabled at the ffmpeg build level; listing re-enables,
#     giving audio on ordinary editorial QuickTimes.
#   * h264 — not gated in this OpenRV version; listed to record intent.
# Studio decision 2026-07: h.264/h.265 review QuickTimes with AAC audio are
# required. Enabling these is the studio's patent-license call — upstream's
# source comments say as much (EXR needs nothing here; OpenEXR is core).
#   * prores / dnxhd — comp and editorial interchange QuickTimes (found the
#     hard way 2026-07-16: rvio failed on a Fly comp with "Unsupported
#     codec_id '147'" = prores). Both sit in upstream's
#     NON_FREE_DECODERS_TO_DISABLE list in cmake/dependencies/ffmpeg.cmake;
#     listing them here re-enables them.
: "${SEQ_FFMPEG_NON_FREE_DECODERS:=hevc,aac,aac_at,aac_fixed,aac_latm,h264,prores,dnxhd}"

# Non-free ENCODERS to enable (for rvio writing movies): aac gives audio in
# written review movies. prores/dnxhd let rvio write comp-quality QuickTimes
# (e.g. SeqBurn burn-in copies) instead of only mjpeg. h.264/h.265 VIDEO
# encoding is a different problem — ffmpeg has no built-in software encoders
# for those; see docs/building-openrv.md §Codecs for the recommended
# two-step path.
: "${SEQ_FFMPEG_NON_FREE_ENCODERS:=aac,prores,dnxhd}"
