# The Sequence Group — studio build configuration.
# Sourced by scripts/build_openrv.sh; environment variables set before the
# script runs take precedence over the defaults recorded here.
#
# This file IS the studio's codec/platform decision of record. Change it in a
# reviewed commit, not ad hoc on a build machine.

# Primary deployment platform (informational; the build runs on the host OS).
: "${SEQ_TARGET_PLATFORM:=windows}"

# ffmpeg non-free DECODERS to enable in the OpenRV build.
# Studio decision 2026-07: review media arrives as h.264/h.265 QuickTimes
# (with AAC audio) alongside EXR sequences, so decode support for these is
# required. EXR needs nothing here — OpenEXR is core, not ffmpeg.
: "${SEQ_FFMPEG_NON_FREE_DECODERS:=h264,hevc,aac}"

# ffmpeg non-free ENCODERS to enable (for rvio writing movies).
# Left empty: ffmpeg has no built-in software h.264/h.265 encoders — those
# need libx264/libx265 (GPL) or NVENC added to the ffmpeg build, which is a
# separate licensing + build decision. See docs/building-openrv.md §Codecs
# for the recommended encode path in the meantime.
: "${SEQ_FFMPEG_NON_FREE_ENCODERS:=}"
