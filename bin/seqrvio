#!/usr/bin/env bash
# Copyright (c) 2026 The Sequence Group.
# SPDX-License-Identifier: Apache-2.0
#
# seqrvio — The Sequence Group launcher for rvio (batch/offline renders).
#
#   seqrvio [--show SHOW] [--rvio /path/to/rvio] [rvio args…]
#
# Mirrors seqrv: exports studio environment (including per-show OCIO) and
# execs the real rvio, so farm/batch renders match interactive review color.

set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SEQ_KIT_ROOT="${SEQ_KIT_ROOT:-$(dirname "$SELF")}"

RVIO_BIN="${SEQ_RVIO_BIN:-}"
PASS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --show)
            export SEQ_SHOW="$2"; shift 2 ;;
        --rvio)
            RVIO_BIN="$2"; shift 2 ;;
        -h|--help)
            sed -n '5,11p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *)
            PASS+=("$1"); shift ;;
    esac
done

if [ -z "${OCIO:-}" ] && [ -n "${SEQ_SHOW:-}" ]; then
    rules="${SEQ_OCIO_RULES:-$SEQ_KIT_ROOT/configs/ocio_rules.json}"
    if [ -f "$rules" ]; then
        resolved="$(python3 - "$rules" "$SEQ_SHOW" <<'PYEOF' || true
import json, os, re, sys
rules_path, show = sys.argv[1], sys.argv[2]
with open(rules_path) as fh:
    rules = json.load(fh)
configs = rules.get("config_by_show", {})
path = configs.get(show) or configs.get("default") or ""
path = re.sub(r"\$\{(\w+)\}", lambda m: os.environ.get(m.group(1), ""), path)
if path and os.path.isfile(path):
    print(path)
PYEOF
)"
        if [ -n "$resolved" ]; then
            export OCIO="$resolved"
            echo "seqrvio: OCIO=$OCIO" >&2
        fi
    fi
fi

if [ -z "$RVIO_BIN" ] && [ -x "$SELF/rvio" ]; then RVIO_BIN="$SELF/rvio"; fi
if [ -z "$RVIO_BIN" ]; then RVIO_BIN="$(command -v rvio || true)"; fi
if [ -z "$RVIO_BIN" ]; then
    echo "seqrvio: cannot find an 'rvio' binary (use --rvio, SEQ_RVIO_BIN, or PATH)" >&2
    exit 1
fi

exec "$RVIO_BIN" ${PASS[@]+"${PASS[@]}"}
